# Copy this file to .env and fill in real values before starting the server.

# REQUIRED: Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars

# Admin bootstrap credentials (used only on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=strong-admin-password-here

# Server bind
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama3.2:3b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# RAG tuning
RAG_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
